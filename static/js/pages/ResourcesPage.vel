<script>
export default {
  data() { return { query: '', state: window.HTMLStudioLearning?.getState?.() || { completedChallenges: [], currentChallenge: 1, projectsCompleted: [], xp: 0 }, catalog: window.HTMLStudioLearning || { challenges: [], tracks: [], projects: [], resources: [], videos: [] }, updateHandler: null } },
  computed: {
    current() { return this.catalog.currentFor ? this.catalog.currentFor(this.state) : this.catalog.challenges[0] },
    durationLabel() { return this.catalog.duration?.label || '10+ hours' },
    achievements() { return this.catalog.achievementsFor ? this.catalog.achievementsFor(this.state) : [] },
    earnedCount() { return this.achievements.filter(item => item.earned).length },
    next() { return this.current?.nextChallenge ? this.catalog.challenges.find(item => item.id === this.current.nextChallenge) : null },
    progressPercent() { return Math.round((this.state.completedChallenges.length / 50) * 100) },
    searchResults() { return this.query.trim() ? this.catalog.search(this.query) : [] },
    visibleProjects() { return this.catalog.projects.filter(item => !item.advanced || this.state.completedChallenges.length >= item.unlockAfter) },
  },
  mounted() { this.updateHandler = event => { this.state = event.detail || this.catalog.getState() }; window.addEventListener('html-studio-learning-updated', this.updateHandler) },
  beforeUnmount() { if (this.updateHandler) window.removeEventListener('html-studio-learning-updated', this.updateHandler) },
  methods: {
    openChallenge(id) { this.catalog.startChallenge(id).catch(error => window.VelStudioShell?.setStatus?.(error.message)) },
    openProject(id) { this.catalog.startProject?.(id).catch(error => window.VelStudioShell?.setStatus?.(error.message)) },
    showChallenges() { window.VelStudioShell?.showChallenges?.() },
    openStarter() { window.VelStudioShell?.showEditor?.(); window.VelStudioEditor?.open?.('index.html') },
    done(id) { return this.state.completedChallenges.includes(id) },
    trackProgress(track) { return track.challenges.filter(item => this.done(item.id)).length },
  },
}
</script>

<template>
  <main class="learn-page">
    <header class="learn-hero"><div class="hero-copy"><p class="hero-kicker">HTML STUDIO · LEARNING PATH</p><h1>Learn by <span>making.</span></h1><p class="hero-lede">Start with one HTML tag. Finish by building real websites, apps, and your own tiny development tool.</p><p class="duration-note">{{ durationLabel }} of guided practice · read, try, run, check, and stretch every idea.</p><div class="hero-actions"><button class="hero-primary" @click="openChallenge(current.id)">Continue challenge {{ current.id }} <b>→</b></button><button class="hero-secondary" @click="showChallenges">Open challenge room</button></div></div><div class="hero-progress"><div class="progress-ring"><strong>{{ progressPercent }}<small>%</small></strong><span>journey</span></div><div><strong>{{ state.completedChallenges.length }} / 50</strong><span>challenges complete</span></div><div><strong>{{ state.xp }} XP</strong><span>earned by building</span></div></div></header>
      <section class="learn-content">
      <div class="learning-search"><label><span>⌕</span><input v-model="query" aria-label="Search learning" placeholder="Search lessons, projects, HTML, CSS, JavaScript..." /></label><span class="search-note">Find a lesson, challenge, or project</span></div>
      <section v-if="query.trim()" class="search-panel"><div class="section-label"><span>SEARCH RESULTS</span><small>{{ searchResults.length }} matches</small></div><div class="search-grid"><button v-for="result in searchResults" :key="result.kind + result.title" class="search-card" @click="result.kind === 'Challenge' ? openChallenge(result.id) : result.kind === 'Project' ? openProject(result.id) : null"><span>{{ result.kind }}</span><strong>{{ result.title }}</strong><small>{{ result.detail }}</small></button></div><p v-if="searchResults.length === 0" class="empty">No learning matches yet. Try HTML, flexbox, DOM, CDN, or projects.</p></section>
      <section v-if="!query.trim()" class="continue-grid"><article class="current-card"><div class="section-label"><span>CURRENT LESSON</span><b>CHALLENGE {{ current.id }} / 50</b></div><div class="current-main"><div class="challenge-number">{{ current.id }}</div><div><h2>{{ current.title }}</h2><p>{{ current.instructions }}</p><div class="meta-row"><span>{{ current.track }}</span><span>{{ current.difficulty }}</span><span>{{ current.estimatedTime }}</span></div></div></div><div class="current-footer"><button class="solid-button" @click="openChallenge(current.id)">Open code <b>→</b></button><button class="text-button" @click="showChallenges">See mission</button></div></article><article class="next-card"><div class="section-label"><span>NEXT LESSON</span><small>{{ next ? 'Unlocks after this challenge' : 'Journey complete' }}</small></div><div v-if="next"><span class="next-number">{{ next.id }}</span><h3>{{ next.title }}</h3><p>{{ next.track }} · {{ next.concept }}</p></div><div v-if="!next"><span class="trophy">✦</span><h3>You reached the finish line.</h3><p>Keep experimenting in the editor and revisit your projects.</p></div><button class="outline-button" @click="next ? openChallenge(next.id) : openStarter()">{{ next ? 'Preview next lesson' : 'Build another idea' }} <b>→</b></button></article></section>
      <section class="path-section"><div class="section-heading"><div><p class="eyebrow">YOUR PATH</p><h2>Small steps. Real things.</h2></div><span class="path-caption">{{ state.completedChallenges.length }} completed · {{ 50 - state.completedChallenges.length }} to explore</span></div><div class="path-list"><article v-for="track in catalog.tracks" :key="track.id" class="track-row" :class="track.color"><div class="track-heading"><div class="track-icon">{{ track.id === 'html' ? '&lt;/&gt;' : track.id === 'css' || track.id === 'layout' ? '✧' : track.id === 'javascript' ? 'JS' : track.id === 'projects' ? '◆' : track.id === 'cdn' ? '◈' : '⚙' }}</div><div><h3>{{ track.name }}</h3><p>{{ track.subtitle }}</p></div><span v-if="!track.optional" class="track-count">{{ trackProgress(track) }} / {{ track.challenges.length }}</span><span v-if="track.optional" class="track-count">OPTIONAL</span></div><div v-if="!track.optional" class="challenge-dots"><button v-for="item in track.challenges" :key="item.id" class="path-dot" :class="{ complete: done(item.id), current: item.id === current.id, locked: !done(item.id) && !state.unlockedChallenges.includes(item.id) }" :title="'Challenge ' + item.id + ': ' + item.title" @click="openChallenge(item.id)"><span>{{ done(item.id) ? '✓' : item.id }}</span></button></div><div v-if="track.optional" class="optional-copy">Build tools, learn the editor, and experiment freely. The actual code editor is always open for exploration.</div></article></div></section>
      <section class="projects-section"><div class="section-heading"><div><p class="eyebrow">MILESTONE PROJECTS</p><h2>Build something you can show.</h2></div><span class="path-caption">Unlocked as you grow</span></div><div class="project-grid"><article v-for="project in visibleProjects" :key="project.id" class="project-card" :class="{ locked: state.completedChallenges.length < project.unlockAfter }"><div class="project-top"><span class="project-icon">{{ project.id === 'mini-ide' ? '▣' : project.id === 'library-power' ? '◈' : '✦' }}</span><span>{{ project.technology }}</span></div><h3>{{ project.title }}</h3><p>{{ project.description }}</p><small>Build with {{ project.requirements }}.</small><button v-if="state.completedChallenges.length >= project.unlockAfter" @click="openProject(project.id)">Open project <b>→</b></button><span v-if="state.completedChallenges.length < project.unlockAfter" class="unlock-note">Complete challenge {{ project.unlockAfter }} to unlock</span></article></div></section>
      <section class="explore-section"><div class="section-heading"><div><p class="eyebrow">WATCH & LEARN</p><h2>Good explanations, when you want one.</h2></div><span class="path-caption">Optional · opens YouTube</span></div><div class="video-grid"><a v-for="video in catalog.videos" :key="video.url" class="video-card" :href="video.url" target="_blank" rel="noopener noreferrer"><span class="play-icon">▶</span><div><strong>{{ video.title }}</strong><small>{{ video.channel }} · {{ video.topic }}</small></div><b>↗</b></a></div></section>
      <section class="explore-section"><div class="section-heading"><div><p class="eyebrow">REFERENCE DESK</p><h2>Keep a trusted tab nearby.</h2></div></div><div class="resource-grid"><a v-for="resource in catalog.resources" :key="resource.url" class="resource-card" :href="resource.url" target="_blank" rel="noopener noreferrer"><span>{{ resource.kind }}</span><strong>{{ resource.name }}</strong><small>{{ resource.detail }}</small><b>↗</b></a></div></section>
      <section class="achievements-section"><div class="section-heading"><div><p class="eyebrow">ACHIEVEMENTS</p><h2>Proof of progress.</h2></div><span class="path-caption">{{ earnedCount }} earned</span></div><div class="achievement-list"><span v-for="achievement in achievements" :key="achievement.name" :class="{ earned: achievement.earned }" :title="achievement.name">{{ achievement.earned ? '✦' : '·' }} {{ achievement.name }}</span></div></section>
    </section>
  </main>
</template>

<style scoped>
.learn-page { min-height: 100%; overflow: auto; background: #0a1220; color: #dfe9f7; }.learn-hero { display: flex; align-items: end; justify-content: space-between; gap: 2rem; min-height: 15rem; padding: clamp(1.6rem, 4vw, 3.5rem) clamp(1.2rem, 5vw, 4rem) 2.3rem; background: radial-gradient(circle at 85% 18%, #1f6f83aa, transparent 28%), radial-gradient(circle at 50% 100%, #503b8288, transparent 38%), linear-gradient(135deg, #142e4c, #151b37 65%, #252040); border-bottom: 1px solid #304467; }.hero-kicker, .eyebrow { margin: 0; color: #72e4d1; font-size: .63rem; font-weight: 900; letter-spacing: .15em; }.hero-copy { max-width: 45rem; }.learn-hero h1 { margin: .65rem 0 .35rem; color: #fff; font-size: clamp(2.3rem, 5vw, 4.4rem); letter-spacing: -.065em; line-height: .95; }.learn-hero h1 span { color: #ffc96b; }.hero-lede { max-width: 38rem; margin: 0; color: #b7c9e2; font-size: .96rem; }.duration-note { margin: .7rem 0 0; color: #72e4d1; font-size: .68rem; font-weight: 800; letter-spacing: .02em; }.hero-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.45rem; }.hero-actions button, .solid-button, .outline-button { border-radius: .45rem; padding: .62rem .8rem; font-weight: 800; cursor: pointer; }.hero-primary, .solid-button { border: 0; background: #70dfce; color: #0b2030; box-shadow: 0 3px 0 #318e88; }.hero-secondary { border: 1px solid #7188ad; background: #18284366; color: #eef5ff; }.hero-actions b, .solid-button b, .outline-button b { margin-left: .45rem; }.hero-progress { display: grid; grid-template-columns: auto auto; align-items: center; gap: .8rem 1.1rem; min-width: 14rem; padding: 1rem; border: 1px solid #5b6793; border-radius: .8rem; background: #0d1729aa; }.hero-progress > div:not(.progress-ring) { display: grid; gap: .1rem; }.hero-progress strong { color: #f5f8ff; font-size: .95rem; }.hero-progress span { color: #99acce; font-size: .63rem; }.progress-ring { display: grid; grid-row: span 2; place-items: center; width: 5rem; height: 5rem; border: 6px solid #5fe1cd; border-right-color: #695f9d; border-radius: 50%; }.progress-ring strong { font-size: 1.25rem; }.progress-ring small { font-size: .65rem; }.progress-ring span { margin-top: -1.1rem; }.learn-content { max-width: 86rem; margin: 0 auto; padding: 1.3rem clamp(1.2rem, 5vw, 4rem) 4rem; }.learning-search { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.15rem; }.learning-search label { display: flex; align-items: center; gap: .55rem; width: min(33rem, 100%); border: 1px solid #354b6a; border-radius: .45rem; padding: .6rem .75rem; background: #111d31; }.learning-search label:focus-within { border-color: #6ce0d0; box-shadow: 0 0 0 3px #6ce0d022; }.learning-search label span { color: #6ce0d0; font-size: 1.1rem; }.learning-search input { width: 100%; border: 0; outline: 0; background: transparent; color: #edf4ff; }.learning-search input::placeholder { color: #7287a4; }.search-note, .path-caption { color: #7187a3; font-size: .67rem; }.section-heading, .section-label { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }.section-label { align-items: center; color: #79dfd0; font-size: .63rem; font-weight: 900; letter-spacing: .12em; }.section-label small { color: #778baa; font-size: .66rem; font-weight: 500; letter-spacing: 0; }.section-label b { color: #ffc96b; font-size: .62rem; }.continue-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(15rem, .8fr); gap: .8rem; }.current-card, .next-card { border: 1px solid #345273; border-radius: .7rem; padding: 1.1rem; background: linear-gradient(145deg, #162d4b, #131f37); }.current-main { display: flex; gap: 1rem; margin: 1.35rem 0 1.1rem; }.challenge-number, .next-number { display: grid; place-items: center; flex: 0 0 3.6rem; height: 3.6rem; border-radius: .6rem; background: #4e3f86; color: #fff; font-size: 1.35rem; font-weight: 900; }.current-main h2 { margin: .1rem 0 .35rem; color: #fff; font-size: 1.35rem; }.current-main p, .next-card p { margin: 0; color: #adbed7; font-size: .78rem; }.meta-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .75rem; }.meta-row span { border-radius: 1rem; padding: .22rem .45rem; background: #253f5f; color: #84a0bd; font-size: .58rem; }.current-footer { display: flex; align-items: center; gap: .7rem; border-top: 1px solid #294361; padding-top: .85rem; }.text-button { border: 0; background: transparent; color: #a8bee0; cursor: pointer; font-size: .72rem; }.next-card { background: linear-gradient(145deg, #273348, #201f3b); }.next-card h3 { margin: .8rem 0 .2rem; color: #fff; }.next-card .next-number { width: 2.3rem; height: 2.3rem; background: #304f69; color: #70dfce; font-size: .9rem; }.next-card .outline-button { margin-top: 1.3rem; border: 1px solid #60799c; background: transparent; color: #ecf3ff; }.trophy { color: #ffc96b; font-size: 2rem; }.search-panel { margin-bottom: 1.25rem; border: 1px solid #334d6e; border-radius: .7rem; padding: 1rem; background: #111e32; }.search-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; margin-top: .8rem; }.search-card { display: grid; gap: .25rem; border: 1px solid #294261; border-radius: .45rem; padding: .75rem; background: #162943; color: #e7effd; text-align: left; cursor: pointer; }.search-card:hover { border-color: #70dfce; }.search-card span { color: #ffc96b; font-size: .58rem; font-weight: 900; text-transform: uppercase; }.search-card strong { font-size: .78rem; }.search-card small { color: #90a7c4; font-size: .67rem; }.empty { color: #8095b2; font-size: .75rem; }.path-section, .projects-section, .explore-section, .achievements-section { margin-top: 2rem; }.section-heading h2 { margin: .25rem 0 0; color: #fff; font-size: 1.3rem; letter-spacing: -.03em; }.path-list { display: grid; gap: .55rem; margin-top: 1rem; }.track-row { border-left: 3px solid #70dfce; border-radius: .5rem; padding: .8rem 1rem; background: #111d30; }.track-row.gold { border-color: #ffc96b; }.track-row.blue { border-color: #86b5f2; }.track-row.pink { border-color: #f09dc3; }.track-row.orange { border-color: #edaa79; }.track-row.violet { border-color: #be9bea; }.track-row.teal { border-color: #70dfce; }.track-heading { display: flex; align-items: center; gap: .65rem; }.track-icon { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .42rem; background: #1b3d4c; color: #70dfce; font-size: .72rem; font-weight: 900; }.gold .track-icon { background: #493a24; color: #ffc96b; }.blue .track-icon { background: #263b58; color: #86b5f2; }.pink .track-icon { background: #4a2e45; color: #f09dc3; }.orange .track-icon { background: #4b342a; color: #edaa79; }.violet .track-icon { background: #3d3052; color: #be9bea; }.track-heading h3 { margin: 0; color: #eff5ff; font-size: .86rem; }.track-heading p { margin: .1rem 0 0; color: #8299b6; font-size: .64rem; }.track-count { margin-left: auto; color: #89a0bc; font-size: .65rem; }.challenge-dots { display: flex; flex-wrap: wrap; gap: .35rem; margin: .75rem 0 0 2.7rem; }.path-dot { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border: 1px solid #385572; border-radius: 50%; background: #172a43; color: #8da8c7; font-size: .57rem; cursor: pointer; }.path-dot:hover, .path-dot.current { border-color: #70dfce; color: #fff; box-shadow: 0 0 0 3px #70dfce22; }.path-dot.complete { border-color: #70dfce; background: #20534f; color: #70dfce; }.path-dot.locked { opacity: .5; }.optional-copy { margin: .75rem 0 0 2.7rem; color: #8299b6; font-size: .7rem; }.project-grid, .video-grid, .resource-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; margin-top: 1rem; }.project-card, .video-card, .resource-card { position: relative; border: 1px solid #2b4564; border-radius: .55rem; padding: .9rem; background: #111d30; }.project-top { display: flex; align-items: center; justify-content: space-between; color: #87a3c2; font-size: .6rem; }.project-icon { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .4rem; background: #403266; color: #ffc96b; font-size: 1.05rem; }.project-card h3 { margin: .75rem 0 .25rem; color: #fff; font-size: .9rem; }.project-card p { min-height: 2.2rem; margin: 0; color: #a6bad3; font-size: .7rem; }.project-card small { display: block; min-height: 2rem; margin-top: .6rem; color: #758ca8; font-size: .62rem; }.project-card button { margin-top: .7rem; border: 0; background: transparent; color: #70dfce; font-size: .68rem; font-weight: 800; cursor: pointer; }.project-card button b { margin-left: .35rem; }.unlock-note { display: block; margin-top: .7rem; color: #7186a1; font-size: .61rem; }.video-card, .resource-card { display: flex; align-items: center; gap: .65rem; color: #eef4ff; text-decoration: none; }.video-card:hover, .resource-card:hover { border-color: #70dfce; }.play-icon { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: #275d65; color: #70dfce; font-size: .65rem; }.video-card strong, .resource-card strong { display: block; font-size: .75rem; }.video-card small, .resource-card small { display: block; margin-top: .18rem; color: #8198b4; font-size: .62rem; }.video-card > b, .resource-card > b { margin-left: auto; color: #70dfce; }.resource-card { display: grid; align-content: start; gap: .18rem; }.resource-card > span { color: #ffc96b; font-size: .57rem; font-weight: 900; text-transform: uppercase; }.resource-card > b { position: absolute; right: .8rem; bottom: .8rem; }.achievement-list { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }.achievement-list span { border: 1px solid #2a3b56; border-radius: 1rem; padding: .35rem .55rem; color: #566c87; font-size: .58rem; font-weight: 800; }.achievement-list span.earned { border-color: #725d8e; background: #342c52; color: #ffc96b; }
@media (max-width: 900px) { .learn-hero { align-items: start; flex-direction: column; }.hero-progress { width: 100%; grid-template-columns: auto repeat(2, 1fr); }.continue-grid { grid-template-columns: 1fr; }.project-grid, .video-grid, .resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 620px) { .learn-content { padding-inline: .85rem; }.learning-search { align-items: start; flex-direction: column; }.hero-progress { grid-template-columns: auto auto; }.search-grid, .project-grid, .video-grid, .resource-grid { grid-template-columns: 1fr; }.section-heading { align-items: start; flex-direction: column; }.path-caption { font-size: .62rem; }.challenge-dots { margin-left: 0; }.optional-copy { margin-left: 0; }.current-main { gap: .65rem; }.challenge-number { flex-basis: 2.8rem; height: 2.8rem; }.current-footer { align-items: start; flex-direction: column; } }
</style>

<style>
/* Keep the lesson surface inside the shell so the whole path is reachable
   with the mouse wheel, touchpad, keyboard, and Tauri's WebView scrollbar. */
.learn-page { width: 100%; height: 100%; max-height: 100%; min-height: 0; overflow-y: auto; overflow-x: hidden; scrollbar-gutter: stable; scrollbar-color: #466486 #0d1728; padding-bottom: 1.5rem; }
.learn-page::-webkit-scrollbar { width: .72rem; }
.learn-page::-webkit-scrollbar-track { background: #0d1728; }
.learn-page::-webkit-scrollbar-thumb { border: 2px solid #0d1728; border-radius: 1rem; background: #466486; }
.learn-hero, .learn-content { min-width: 0; }
.hero-copy { min-width: 0; }
.learn-hero h1, .hero-lede, .current-main h2, .current-main p, .next-card h3, .next-card p, .project-card h3, .project-card p { overflow-wrap: anywhere; }
@media (max-width: 900px) { .learn-hero { align-items: flex-start; flex-direction: column; } .hero-progress { width: min(100%, 28rem); } }
</style>

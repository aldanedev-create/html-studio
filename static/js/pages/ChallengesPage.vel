<script>
export default {
  data() { const catalog = window.HTMLStudioLearning || { challenges: [], tracks: [], getState: () => ({ completedChallenges: [], currentChallenge: 1, hintsUsed: {} }) }; return { catalog, state: catalog.getState(), feedback: '', checking: false, updateHandler: null } },
  computed: {
    current() { return this.catalog.currentFor(this.state) },
    currentTrack() { return this.catalog.tracks.find(track => track.challenges.some(item => item.id === this.current.id)) || this.catalog.tracks[0] },
    done() { return this.state.completedChallenges.includes(this.current.id) },
    hintCount() { return Math.min(3, Number(this.state.hintsUsed?.[this.current.id] || 0)) },
    visibleHints() { return this.current.hints.slice(0, this.hintCount) },
    previous() { return this.catalog.challenges.find(item => item.id === this.current.id - 1) || null },
    next() { return this.current.nextChallenge ? this.catalog.challenges.find(item => item.id === this.current.nextChallenge) : null },
  },
  mounted() { this.updateHandler = event => { this.state = event.detail || this.catalog.getState() }; window.addEventListener('html-studio-learning-updated', this.updateHandler) },
  beforeUnmount() { if (this.updateHandler) window.removeEventListener('html-studio-learning-updated', this.updateHandler); window.VelStudioPreview?.dispose?.('challenge-preview-frame') },
  methods: {
    openCode() { this.catalog.startChallenge(this.current.id).catch(error => { this.feedback = error.message; window.VelStudioShell?.setStatus?.(error.message) }) },
    async run() { window.VelStudioPreview?.mount?.('challenge-preview-frame'); const refreshed = await window.VelStudioPreview?.refresh?.(); if (refreshed === false) this.feedback = 'Open the code workspace first, then run your project.' },
    showHint() { if (this.hintCount < 3) this.state = this.catalog.useHint(this.current.id) },
    async check() { if (this.checking) return; this.checking = true; this.feedback = 'Running your preview and checking the files…'; const result = await this.catalog.checkChallenge(this.current.id); this.feedback = result.message; this.checking = false; if (result.state) this.state = result.state },
    choose(id) { const item = this.catalog.challenges.find(challenge => challenge.id === id); if (!item) return; if (!this.state.unlockedChallenges.includes(id) && id !== this.state.currentChallenge) { this.feedback = 'Finish the previous challenge to unlock this one.'; return } this.state = this.catalog.saveState({ ...this.state, currentChallenge: id }); this.feedback = '' },
    nextChallenge() { if (this.next) this.choose(this.next.id) },
    previousChallenge() { if (this.previous) this.choose(this.previous.id) },
    openProject() { if (this.current.projectId) window.HTMLStudioLearning.startProject?.(this.current.projectId).catch(error => { this.feedback = error.message }) },
    showEditor() { window.VelStudioShell?.showEditor?.() },
    showLearning() { window.VelStudioShell?.showLearn?.() },
  },
}
</script>

<template>
  <main class="challenge-page">
    <header class="challenge-top"><div><p class="eyebrow">MISSION ROOM</p><h1>Challenge {{ current.id }} <span>/ 50</span></h1><p class="top-copy">{{ current.track }} · {{ current.module }}</p></div><div class="top-progress"><strong>{{ state.completedChallenges.length }} / 50</strong><span>completed</span><div class="progress-line"><i :style="{ width: ((state.completedChallenges.length / 50) * 100) + '%' }"></i></div></div></header>
    <nav class="lesson-toolbar" aria-label="Lesson navigation"><button class="lesson-back" @click="showLearning">← Back to lessons</button><div class="lesson-location"><strong>Lesson {{ current.id }} of 50</strong><span>Read, try, run, check, then move on.</span></div><div class="lesson-arrows"><button @click="previousChallenge" :disabled="!previous">← Previous</button><button @click="nextChallenge" :disabled="!done || !next">Next →</button></div></nav>
    <section class="challenge-layout">
      <aside class="learn-column"><div class="column-title"><span>LEARN</span><span>{{ current.estimatedTime }}</span></div><span class="difficulty">{{ current.difficulty }}</span><h2>{{ current.title }}</h2><p class="lesson-count">5 guided actions · 3 experiments · 3 self-check questions</p><div class="learn-card"><strong>WHAT IS IT?</strong><p>{{ current.lesson.whatIsIt }}</p><strong>WHY DO DEVELOPERS USE IT?</strong><p>{{ current.lesson.whyDevelopersUseIt }}</p><strong>KEY IDEA</strong><p>{{ current.lesson.keyIdea }}</p><strong>EXAMPLE TO STUDY</strong><pre>{{ current.lesson.example }}</pre><strong>TRY IT IN THREE MOVES</strong><ol class="lesson-steps"><li v-for="step in current.lesson.steps" :key="step">{{ step }}</li></ol><strong>RUN / TEST</strong><p>{{ current.lesson.test }}</p><strong>FIX IT LIKE A DEVELOPER</strong><p>{{ current.lesson.fix }}</p><strong>REFLECT</strong><p class="reflection">{{ current.lesson.reflect }}</p></div><div class="lesson-extra"><div class="extra-block"><strong>WORDS TO KNOW</strong><p v-for="word in current.lesson.vocabulary" :key="word">{{ word }}</p></div><div class="extra-block"><strong>GUIDED WORKSHOP</strong><ol class="lesson-steps"><li v-for="step in current.lesson.guidedPractice" :key="step">{{ step }}</li></ol></div><div class="extra-block"><strong>EXPERIMENTS</strong><p v-for="experiment in current.lesson.experiments" :key="experiment">✦ {{ experiment }}</p></div><div class="extra-block"><strong>SELF-CHECK</strong><p v-for="question in current.lesson.selfCheck" :key="question">□ {{ question }}</p></div><div class="stretch"><strong>STRETCH TASK</strong><p>{{ current.lesson.stretch }}</p></div></div><div class="mistakes"><strong>COMMON MISTAKES</strong><p v-for="mistake in current.commonMistakes" :key="mistake">• {{ mistake }}</p></div></aside>
      <section class="mission-column"><div class="column-title"><span>MISSION</span><span>Make it yours</span></div><article class="mission-card"><div class="mission-badge">CHALLENGE {{ current.id }}</div><h2>{{ current.instructions }}</h2><p>Your work is checked by looking at the actual files in the challenge workspace. Different designs are welcome—meet the idea, not one exact answer.</p><div class="goals"><strong>SUCCESS CRITERIA</strong><span>{{ current.successCriteria }}</span></div><div class="editor-handoff"><div class="handoff-icon">&lt;/&gt;</div><div><strong>Real editor workspace</strong><small>Starter files are copied into a separate learning project. Your personal projects stay safe.</small></div><button @click="openCode">Open code <b>→</b></button></div><div class="workflow"><span class="active">1 Learn</span><span class="active">2 Try</span><span>3 Run</span><span>4 Check</span></div></article><div class="hint-card"><div><strong>Need a nudge?</strong><small>Hints guide you without taking away the discovery.</small></div><button v-if="hintCount < 3" @click="showHint">Show hint {{ hintCount + 1 }} / 3</button><span v-if="hintCount >= 3">All hints shown</span><div v-if="visibleHints.length" class="hint-list"><p v-for="(hint, index) in visibleHints" :key="hint"><b>{{ index + 1 }}</b>{{ hint }}</p></div></div></section>
      <aside class="preview-column"><div class="column-title"><span>LIVE PREVIEW</span><span>Use Run in the editor</span></div><div class="preview-card"><div class="preview-window"><div class="window-bar"><i></i><i></i><i></i><span>learning workspace</span></div><div class="preview-illustration"><span class="preview-code">&lt;/&gt;</span><strong>See your idea here</strong><small>Open code, then press Run to update the preview.</small><iframe id="challenge-preview-frame" title="Challenge website preview" sandbox="allow-scripts" hidden aria-label="Challenge website preview"></iframe></div></div><div class="preview-actions"><button class="run-button" aria-label="Run preview" title="Run your challenge preview" @click="run">▶ Run preview</button><button class="editor-button" @click="showEditor">Open editor</button></div></div><div class="check-card"><span class="check-icon">{{ done ? '✓' : '?' }}</span><div><strong>{{ done ? 'Challenge complete!' : 'Ready to check?' }}</strong><small>{{ done ? '+100 XP · Nice work.' : 'Run your code, then ask HTML Studio to inspect it.' }}</small></div><button v-if="!done" @click="check" :disabled="checking">{{ checking ? 'Checking…' : 'Check challenge' }}</button><button v-if="done && next" @click="nextChallenge">Next challenge →</button><button v-if="done && !next" @click="showEditor">Keep building →</button></div><p v-if="feedback" class="feedback" :class="{ success: done }" aria-live="polite">{{ feedback }}</p></aside>
    </section>
    <section class="challenge-nav"><div class="nav-heading"><div><p class="eyebrow">KEEP GOING</p><h2>{{ currentTrack.name }}</h2></div><span>{{ currentTrack.challenges.length }} challenges in this module</span></div><div class="nav-dots"><button v-for="item in currentTrack.challenges" :key="item.id" :class="{ complete: state.completedChallenges.includes(item.id), selected: item.id === current.id, locked: !state.unlockedChallenges.includes(item.id) && !state.completedChallenges.includes(item.id) }" :title="item.title" @click="choose(item.id)"><span>{{ state.completedChallenges.includes(item.id) ? '✓' : item.id }}</span><small>{{ item.title }}</small></button></div><div v-if="current.projectId" class="milestone"><span>✦</span><div><strong>Milestone project unlocked after this challenge</strong><small>Build a project that combines what you just learned.</small></div><button @click="openProject">Open project →</button></div></section>
  </main>
</template>

<style scoped>
.challenge-page { min-height: 100%; overflow: auto; background: #0a1220; color: #e1ebf9; }.challenge-top { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 1.35rem clamp(1rem, 4vw, 3rem) 1.1rem; border-bottom: 1px solid #273c59; background: linear-gradient(120deg, #152d49, #171d3b); }.eyebrow { margin: 0; color: #70dfce; font-size: .62rem; font-weight: 900; letter-spacing: .14em; }.challenge-top h1 { margin: .35rem 0 .15rem; color: #fff; font-size: clamp(1.6rem, 3vw, 2.35rem); letter-spacing: -.05em; }.challenge-top h1 span { color: #8298b5; font-size: .9rem; font-weight: 500; }.top-copy { margin: 0; color: #98acc7; font-size: .72rem; }.top-progress { min-width: 11rem; }.top-progress strong, .top-progress span { display: block; }.top-progress strong { color: #fff; font-size: .8rem; }.top-progress span { color: #8096b1; font-size: .62rem; }.progress-line { height: .35rem; margin-top: .45rem; overflow: hidden; border-radius: 1rem; background: #243954; }.progress-line i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #70dfce, #ae94ef); }.challenge-layout { display: grid; grid-template-columns: minmax(13rem, .85fr) minmax(22rem, 1.6fr) minmax(14rem, .9fr); gap: 1px; min-height: 31rem; border-bottom: 1px solid #273c59; background: #273c59; }.learn-column, .mission-column, .preview-column { min-width: 0; padding: 1rem; background: #0d1728; }.mission-column { background: #101b2e; }.column-title { display: flex; align-items: center; justify-content: space-between; gap: .5rem; color: #73dfd0; font-size: .62rem; font-weight: 900; letter-spacing: .12em; }.column-title span:last-child { color: #7188a4; font-size: .6rem; font-weight: 500; letter-spacing: 0; }.difficulty { display: inline-block; margin-top: 1.2rem; border: 1px solid #4e7080; border-radius: 1rem; padding: .24rem .5rem; color: #70dfce; font-size: .6rem; }.learn-column h2, .mission-card h2 { margin: .65rem 0 .8rem; color: #fff; font-size: 1.25rem; line-height: 1.15; }.learn-card { border: 1px solid #2b4564; border-radius: .5rem; padding: .8rem; background: #132238; }.learn-card strong, .mistakes > strong, .goals strong { display: block; color: #ffc96b; font-size: .59rem; letter-spacing: .1em; }.learn-card p { margin: .35rem 0 1rem; color: #a9bdd7; font-size: .73rem; line-height: 1.55; }.learn-card pre { overflow: auto; margin: .35rem 0 0; color: #aee7dc; font: .65rem/1.5 Consolas, monospace; white-space: pre-wrap; }.mistakes { margin-top: 1rem; border-left: 2px solid #d891ab; padding-left: .7rem; }.mistakes > strong { color: #ef9ebb; }.mistakes p { margin: .45rem 0; color: #91a7c2; font-size: .68rem; }.mission-card { border: 1px solid #3c5574; border-radius: .7rem; padding: 1.1rem; background: linear-gradient(145deg, #1c3452, #18243d); }.mission-badge { color: #ffc96b; font-size: .58rem; font-weight: 900; letter-spacing: .13em; }.mission-card h2 { font-size: clamp(1.15rem, 2vw, 1.55rem); }.mission-card > p { margin: 0; color: #b1c3db; font-size: .75rem; line-height: 1.55; }.goals { display: grid; gap: .3rem; margin-top: 1.1rem; border-left: 2px solid #70dfce; padding: .1rem 0 .1rem .7rem; }.goals span { color: #d2e3f4; font-size: .72rem; line-height: 1.4; }.editor-handoff { display: flex; align-items: center; gap: .6rem; margin-top: 1.15rem; border: 1px solid #3f5f74; border-radius: .5rem; padding: .65rem; background: #102b3c; }.handoff-icon { display: grid; place-items: center; flex: 0 0 2rem; height: 2rem; border-radius: .35rem; background: #245f61; color: #70dfce; font-weight: 900; }.editor-handoff div:nth-child(2) { min-width: 0; }.editor-handoff strong, .editor-handoff small { display: block; }.editor-handoff strong { color: #f2f7ff; font-size: .7rem; }.editor-handoff small { margin-top: .18rem; color: #8da9b9; font-size: .6rem; }.editor-handoff button, .check-card button { margin-left: auto; border: 0; border-radius: .35rem; padding: .5rem .6rem; background: #70dfce; color: #092230; font-size: .65rem; font-weight: 900; cursor: pointer; white-space: nowrap; }.workflow { display: flex; justify-content: space-between; gap: .35rem; margin-top: 1rem; color: #69809d; font-size: .58rem; }.workflow span.active { color: #70dfce; }.hint-card { display: grid; gap: .65rem; margin-top: .7rem; border: 1px solid #3c4e71; border-radius: .55rem; padding: .7rem; background: #1c2341; }.hint-card > div:first-child { display: grid; gap: .2rem; }.hint-card strong { color: #f7e6bd; font-size: .72rem; }.hint-card small, .hint-card > span { color: #a5a8ca; font-size: .62rem; }.hint-card > button { justify-self: start; border: 1px solid #756aa5; border-radius: .35rem; padding: .4rem .6rem; background: transparent; color: #d4c4fa; font-size: .63rem; cursor: pointer; }.hint-list { display: grid; gap: .35rem; }.hint-list p { display: flex; gap: .45rem; margin: 0; color: #bcc3dc; font-size: .65rem; line-height: 1.45; }.hint-list b { display: grid; place-items: center; flex: 0 0 1.1rem; height: 1.1rem; border-radius: 50%; background: #654f90; color: #fff; font-size: .55rem; }.preview-card { margin-top: 1rem; border: 1px solid #344c68; border-radius: .55rem; padding: .55rem; background: #121e31; }.preview-window { overflow: hidden; min-height: 16rem; border: 1px solid #3a4b62; border-radius: .35rem; background: #f6f9fc; }.window-bar { display: flex; align-items: center; gap: .25rem; padding: .45rem; background: #25354b; }.window-bar i { width: .4rem; height: .4rem; border-radius: 50%; background: #e59898; }.window-bar i:nth-child(2) { background: #e5c177; }.window-bar i:nth-child(3) { background: #73d2b6; }.window-bar span { margin-left: .35rem; color: #acc1da; font-size: .55rem; }.preview-illustration { display: grid; place-items: center; align-content: center; min-height: 14rem; gap: .65rem; padding: 1rem; color: #50637d; text-align: center; }.preview-code { display: grid; place-items: center; width: 3.8rem; height: 3.8rem; border-radius: 1rem; background: #dff4f1; color: #258e85; font-size: 1.2rem; font-weight: 900; }.preview-illustration strong { color: #31455e; font-size: .85rem; }.preview-illustration small { color: #8093aa; font-size: .63rem; }.preview-actions { display: flex; gap: .45rem; margin-top: .55rem; }.preview-actions button { flex: 1; border-radius: .35rem; padding: .5rem; font-size: .63rem; font-weight: 800; cursor: pointer; }.run-button { border: 0; background: #70dfce; color: #092230; }.editor-button { border: 1px solid #496683; background: transparent; color: #bcd0e6; }.check-card { display: flex; align-items: center; gap: .55rem; margin-top: .7rem; border: 1px solid #354d6c; border-radius: .55rem; padding: .65rem; background: #182842; }.check-icon { display: grid; place-items: center; flex: 0 0 1.8rem; height: 1.8rem; border-radius: 50%; background: #344265; color: #ffc96b; font-weight: 900; }.check-card strong, .check-card small { display: block; }.check-card strong { color: #f2f6ff; font-size: .68rem; }.check-card small { margin-top: .15rem; color: #91a8c2; font-size: .58rem; }.check-card button { background: #ffc96b; }.check-card button:disabled { opacity: .6; cursor: wait; }.feedback { margin: .55rem 0 0; border-left: 2px solid #ef9ebb; padding: .45rem .55rem; color: #eab3c4; font-size: .65rem; line-height: 1.45; }.feedback.success { border-color: #70dfce; color: #8ee6d8; }.challenge-nav { padding: 1.2rem clamp(1rem, 4vw, 3rem) 2rem; background: #0d1728; }.nav-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }.nav-heading h2 { margin: .2rem 0 0; color: #fff; font-size: 1.1rem; }.nav-heading > span { color: #7188a4; font-size: .65rem; }.nav-dots { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }.nav-dots button { display: grid; grid-template-columns: 1.5rem 1fr; align-items: center; gap: .4rem; min-width: 7.2rem; border: 1px solid #2d4968; border-radius: .35rem; padding: .35rem .45rem; background: #122239; color: #8ca4c0; text-align: left; cursor: pointer; }.nav-dots button > span { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; background: #1e3854; font-size: .58rem; }.nav-dots small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .58rem; }.nav-dots button.selected { border-color: #70dfce; box-shadow: 0 0 0 2px #70dfce22; color: #fff; }.nav-dots button.complete > span { background: #24625b; color: #70dfce; }.nav-dots button.locked { opacity: .48; }.milestone { display: flex; align-items: center; gap: .6rem; margin-top: 1rem; border: 1px solid #665a85; border-radius: .5rem; padding: .7rem; background: #282442; }.milestone > span { color: #ffc96b; font-size: 1.2rem; }.milestone strong, .milestone small { display: block; }.milestone strong { color: #f5ebca; font-size: .68rem; }.milestone small { margin-top: .15rem; color: #aaa7c6; font-size: .6rem; }.milestone button { margin-left: auto; border: 1px solid #806ea2; border-radius: .35rem; padding: .45rem .55rem; background: transparent; color: #e1d4f7; font-size: .6rem; cursor: pointer; white-space: nowrap; }
@media (max-width: 980px) { .challenge-layout { grid-template-columns: minmax(12rem, .8fr) minmax(20rem, 1.4fr); }.preview-column { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(20rem, 1.4fr); gap: .7rem; }.preview-column .column-title { grid-column: 1 / -1; }.preview-card { margin-top: 0; }.check-card { align-self: end; margin-top: 0; } }
@media (max-width: 680px) { .challenge-top { align-items: start; flex-direction: column; }.challenge-layout { display: block; }.learn-column, .mission-column, .preview-column { border-bottom: 1px solid #273c59; }.preview-column { display: block; }.preview-card { margin-top: 1rem; }.check-card { margin-top: .7rem; }.editor-handoff { align-items: start; flex-wrap: wrap; }.editor-handoff button { margin-left: 2.6rem; }.nav-heading { align-items: start; flex-direction: column; }.nav-dots button { min-width: calc(50% - .25rem); }.milestone { align-items: start; flex-wrap: wrap; }.milestone button { margin-left: 2.6rem; } }
.challenge-page { height: 100%; max-height: 100%; min-height: 0; overflow-y: auto; overflow-x: hidden; scrollbar-gutter: stable; scrollbar-color: #466486 #0d1728; padding-bottom: 1.5rem; background: #0a1220; color: #e1ebf9; }.challenge-page::-webkit-scrollbar { width: .72rem; }.challenge-page::-webkit-scrollbar-track { background: #0d1728; }.challenge-page::-webkit-scrollbar-thumb { border: 2px solid #0d1728; border-radius: 1rem; background: #466486; }.lesson-toolbar { position: sticky; z-index: 15; top: 0; display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .55rem clamp(1rem, 4vw, 3rem); border-bottom: 1px solid #263c59; background: #111d30f5; box-shadow: 0 .35rem .8rem #050a1433; }.lesson-toolbar button { border: 1px solid #3a5674; border-radius: .35rem; padding: .42rem .6rem; background: #192b43; color: #d9e6f6; font-size: .65rem; font-weight: 800; cursor: pointer; }.lesson-toolbar button:hover:not(:disabled) { border-color: #70dfce; background: #1d3b4a; color: #fff; }.lesson-toolbar button:disabled { cursor: not-allowed; opacity: .42; }.lesson-back { color: #70dfce !important; }.lesson-location { display: grid; gap: .08rem; min-width: 0; text-align: center; }.lesson-location strong { color: #f3f7ff; font-size: .68rem; }.lesson-location span { color: #8499b4; font-size: .59rem; }.lesson-arrows { display: flex; gap: .4rem; }
@media (max-width: 680px) { .lesson-toolbar { align-items: stretch; flex-wrap: wrap; }.lesson-location { order: -1; width: 100%; text-align: left; }.lesson-arrows { margin-left: auto; } }
.preview-illustration { display: block; min-height: 0; padding: .45rem; background: #e9eff6; }
.preview-illustration iframe { display: block; width: 100%; height: 13.1rem; border: 0; border-radius: .2rem; background: #fff; }
</style>

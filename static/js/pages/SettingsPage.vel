<script>
export default {
  data() { return { theme: 'html-studio-dark', fontSize: '14', tabSize: '2', wordWrap: false, minimap: false, autosave: true } },
  mounted() { this.loadSettings() },
  methods: {
    loadSettings() { try { const saved = JSON.parse(localStorage.getItem('html-studio-settings') || '{}'); if (['html-studio-dark', 'neon-light', 'high-contrast'].includes(saved.theme)) this.theme = saved.theme; if (['12', '14', '16', '18'].includes(String(saved.fontSize))) this.fontSize = String(saved.fontSize); if (['2', '4', '8'].includes(String(saved.tabSize))) this.tabSize = String(saved.tabSize); if (typeof saved.wordWrap === 'boolean') this.wordWrap = saved.wordWrap; if (typeof saved.minimap === 'boolean') this.minimap = saved.minimap; if (typeof saved.autosave === 'boolean') this.autosave = saved.autosave } catch (_) {} this.applyEditorSettings(); window.VelStudioSettings = this },
    persist() { try { localStorage.setItem('html-studio-settings', JSON.stringify({ theme: this.theme, fontSize: this.fontSize, tabSize: this.tabSize, wordWrap: this.wordWrap, minimap: this.minimap, autosave: this.autosave })) } catch (_) { window.VelStudioShell?.setStatus?.('Settings could not be saved') } this.applyEditorSettings(); window.VelStudioSettings = this; window.VelStudioShell?.setStatus?.('Settings saved locally') },
    applyEditorSettings() { window.VelStudioShell?.setTheme?.(this.theme); window.VelStudioEditor?.setTheme?.(this.theme); window.VelStudioEditor?.updateOptions?.({ fontSize: Number(this.fontSize), tabSize: Number(this.tabSize), wordWrap: this.wordWrap ? 'on' : 'off', minimap: { enabled: this.minimap } }) },
    toggle(name) { this[name] = !this[name]; this.persist() },
  },
}
</script>

<template>
  <main class="settings-page"><header class="settings-header"><p class="eyebrow">STUDIO SETTINGS</p><h1>Editor preferences</h1><p class="subhead">These settings are stored on this computer. No account is needed.</p></header><section class="settings-card"><label class="select-row"><span><strong>Editor theme</strong><small>Choose a comfortable code-editor contrast.</small></span><select v-model="theme" @change="persist"><option value="html-studio-dark">HTML Studio Dark</option><option value="neon-light">Neon light</option><option value="high-contrast">High contrast</option></select></label><label class="select-row"><span><strong>Font size</strong><small>Use a larger size while learning.</small></span><select v-model="fontSize" @change="persist"><option value="12">12 px</option><option value="14">14 px</option><option value="16">16 px</option><option value="18">18 px</option></select></label><label class="select-row"><span><strong>Tab size</strong><small>Spaces inserted when you press Tab.</small></span><select v-model="tabSize" @change="persist"><option value="2">2 spaces</option><option value="4">4 spaces</option><option value="8">8 spaces</option></select></label><button class="setting-row" @click="toggle('wordWrap')"><span><strong>Word wrap</strong><small>Wrap long lines inside the editor.</small></span><span class="switch" :class="{ on: wordWrap }">{{ wordWrap ? 'On' : 'Off' }}</span></button><button class="setting-row" @click="toggle('minimap')"><span><strong>Editor minimap</strong><small>Show a compact overview of the current file.</small></span><span class="switch" :class="{ on: minimap }">{{ minimap ? 'On' : 'Off' }}</span></button><button class="setting-row" @click="toggle('autosave')"><span><strong>Autosave recovery snapshots</strong><small>Save edits after a short pause so you can recover work.</small></span><span class="switch" :class="{ on: autosave }">{{ autosave ? 'On' : 'Off' }}</span></button></section></main>
</template>

<style scoped>
.settings-page { height: 100%; overflow: auto; padding: clamp(1.2rem, 5vw, 3.5rem) clamp(1rem, 7vw, 5rem); background: #0c1220; }.settings-header { max-width: 42rem; }.eyebrow { margin: 0 0 .45rem; color: #62d9c7; font-size: .65rem; font-weight: 900; letter-spacing: .14em; }.settings-page h1 { margin: 0; color: #edf4ff; font-size: clamp(1.55rem, 3vw, 2.25rem); letter-spacing: -.03em; }.subhead { margin: .4rem 0 0; color: #8297b3; }.settings-card { display: grid; width: min(50rem, 100%); margin-top: 2rem; border: 1px solid #273b58; border-radius: .5rem; background: #121d30; box-shadow: 0 1rem 2rem #050a1422; }.select-row, .setting-row { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; min-height: 4.1rem; padding: .8rem 1rem; border-bottom: 1px solid #21334d; }.select-row:last-child, .setting-row:last-child { border-bottom: 0; }.select-row > span, .setting-row > span:first-child { display: grid; gap: .25rem; }.select-row strong, .setting-row strong { color: #dce8f8; font-size: .8rem; }.select-row small, .setting-row small { color: #7f94af; font-size: .68rem; }.select-row select { min-width: 10rem; border: 1px solid #35506e; border-radius: .3rem; padding: .45rem .5rem; background: #0d1728; color: #e5effc; font-size: .7rem; }.select-row select:focus { outline: 2px solid #62d9c755; outline-offset: 1px; }.setting-row { width: 100%; border-top: 0; border-right: 0; border-left: 0; background: transparent; color: inherit; text-align: left; cursor: pointer; }.setting-row:hover { background: #182940; }.switch { min-width: 3rem; border: 1px solid #3b526e; border-radius: 99px; padding: .25rem .5rem; color: #8ea2bc; text-align: center; font-size: .65rem; }.switch.on { border-color: #438f85; background: #173d3b; color: #70dfcd; }
@media (max-width: 620px) { .select-row, .setting-row { align-items: flex-start; flex-direction: column; }.select-row select, .switch { width: 100%; } }
</style>

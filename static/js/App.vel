<script>
import Topbar from './components/Topbar.vel'
import ActivityBar from './components/ActivityBar.vel'
import Statusbar from './components/Statusbar.vel'
import EditorPage from './pages/EditorPage.vel'
import LearnPage from './pages/ResourcesPage.vel'
import ChallengesPage from './pages/ChallengesPage.vel'
import SettingsPage from './pages/SettingsPage.vel'

export default {
  data() {
    let theme = 'html-studio-dark'
    try { const saved = JSON.parse(localStorage.getItem('html-studio-settings') || '{}'); if (['html-studio-dark', 'neon-light', 'high-contrast'].includes(saved.theme)) theme = saved.theme } catch (_) {}
    return {
      page: 'editor', status: 'Ready', editorStatus: 'Starting editor', workspaceName: 'starter-site', activeFile: 'index.html', dirty: false,
      theme, sidebarVisible: true, previewVisible: true, bottomVisible: false, bottomTab: 'problems', consoleLines: [], problemCount: 0, running: false,
    }
  },
  mounted() { window.VelStudioShell = this; this.applyTheme(this.theme); window.VelStudioApp?.init?.(this) },
  beforeUnmount() { window.VelStudioApp?.dispose?.(); if (window.VelStudioShell === this) window.VelStudioShell = null },
  methods: {
    showEditor() { if (this.page === 'challenges') window.VelStudioPreview?.dispose?.(); this.page = 'editor' },
    showLearn() { this.page = 'learn' },
    showChallenges() { this.page = 'challenges' },
    showSettings() { this.page = 'settings' },
    setTheme(value) { const next = ['html-studio-dark', 'neon-light', 'high-contrast'].includes(value) ? value : 'html-studio-dark'; this.theme = next; this.applyTheme(next) },
    applyTheme(value) {
      const next = ['html-studio-dark', 'neon-light', 'high-contrast'].includes(value) ? value : 'html-studio-dark'
      document.documentElement.dataset.htmlStudioTheme = next
      let style = document.getElementById('html-studio-theme-style')
      if (!style) { style = document.createElement('style'); style.id = 'html-studio-theme-style'; document.head.appendChild(style) }
      style.textContent = next === 'neon-light' ? `html[data-html-studio-theme="neon-light"] { color-scheme: light; } html[data-html-studio-theme="neon-light"] body { background: #eef5ff !important; } html[data-html-studio-theme="neon-light"] .studio-shell { background: #eef5ff !important; color: #152242 !important; } html[data-html-studio-theme="neon-light"] .topbar, html[data-html-studio-theme="neon-light"] .activity-bar, html[data-html-studio-theme="neon-light"] .statusbar, html[data-html-studio-theme="neon-light"] .workspace-toolbar, html[data-html-studio-theme="neon-light"] .editor-tabs, html[data-html-studio-theme="neon-light"] .tabs, html[data-html-studio-theme="neon-light"] .bottom-panel { background: #ffffff !important; border-color: #bfd0ec !important; } html[data-html-studio-theme="neon-light"] .page-host, html[data-html-studio-theme="neon-light"] .editor-page, html[data-html-studio-theme="neon-light"] .code-column, html[data-html-studio-theme="neon-light"] .editor-pane, html[data-html-studio-theme="neon-light"] .code-editor-container, html[data-html-studio-theme="neon-light"] .explorer, html[data-html-studio-theme="neon-light"] .preview-pane, html[data-html-studio-theme="neon-light"] .settings-page, html[data-html-studio-theme="neon-light"] .learn-page { background: #f4f8ff !important; color: #17244a !important; } html[data-html-studio-theme="neon-light"] .workspace-toolbar strong, html[data-html-studio-theme="neon-light"] .pane-heading, html[data-html-studio-theme="neon-light"] .settings-page h1, html[data-html-studio-theme="neon-light"] .learn-page h1 { color: #152242 !important; } html[data-html-studio-theme="neon-light"] button, html[data-html-studio-theme="neon-light"] select, html[data-html-studio-theme="neon-light"] input { border-color: #a9c1e6 !important; } html[data-html-studio-theme="neon-light"] button:hover, html[data-html-studio-theme="neon-light"] .activity-button.active { background: #dffcff !important; color: #087f91 !important; box-shadow: 0 0 18px #00bfd944 !important; } html[data-html-studio-theme="neon-light"] .workspace-toolbar, html[data-html-studio-theme="neon-light"] .preview-pane, html[data-html-studio-theme="neon-light"] .settings-card { box-shadow: 0 0 22px #00bfd91c !important; }` : next === 'high-contrast' ? `html[data-html-studio-theme="high-contrast"] { color-scheme: dark; } html[data-html-studio-theme="high-contrast"] .studio-shell, html[data-html-studio-theme="high-contrast"] .page-host { background: #000 !important; color: #fff !important; } html[data-html-studio-theme="high-contrast"] button, html[data-html-studio-theme="high-contrast"] select, html[data-html-studio-theme="high-contrast"] input { border-color: #fff !important; color: #fff !important; }` : ''
    },
    setStatus(value) { this.status = value },
    setEditorStatus(value) { this.editorStatus = value },
    setActiveFile(value) { this.activeFile = value },
    setWorkspaceName(value) { if (value) this.workspaceName = value },
    setEditorDirty(value) { this.dirty = Boolean(value) },
    setConsole(lines) { this.consoleLines = Array.isArray(lines) ? lines : [] },
    setProblemCount(value) { this.problemCount = Number(value) || 0 },
    setRunning(value) { this.running = Boolean(value) },
    toggleSidebar() { this.sidebarVisible = !this.sidebarVisible },
    togglePreview() { this.previewVisible = !this.previewVisible },
    toggleBottom(tab) { this.bottomVisible = !this.bottomVisible; if (tab) this.bottomTab = tab },
    setBottomTab(tab) { this.bottomTab = tab; this.bottomVisible = true },
    run() { window.VelStudioApp?.run?.() },
    save() { window.VelStudioEditor?.save?.() },
    refreshWorkspace() { window.VelStudioApp?.refreshWorkspace?.() },
  },
  components: { Topbar, ActivityBar, Statusbar, EditorPage, LearnPage, ChallengesPage, SettingsPage },
}
</script>

<template>
  <main class="studio-shell">
    <Topbar :workspace="workspaceName" :active-file="activeFile" :dirty="dirty" :running="running" />
    <div class="studio-body">
      <ActivityBar :page="page" />
      <section class="page-host">
        <EditorPage v-if="page === 'editor'" :active-file="activeFile" :dirty="dirty" :sidebar-visible="sidebarVisible" :preview-visible="previewVisible" :bottom-visible="bottomVisible" :bottom-tab="bottomTab" :console-lines="consoleLines" :problem-count="problemCount" />
        <LearnPage v-if="page === 'learn'" />
        <ChallengesPage v-if="page === 'challenges'" />
        <SettingsPage v-if="page === 'settings'" />
      </section>
    </div>
    <Statusbar :status="status" :editor-status="editorStatus" :active-file="activeFile" :dirty="dirty" />
  </main>
</template>

<style scoped>
:root { color-scheme: dark; }
* { box-sizing: border-box; }
.studio-shell { min-height: 100vh; height: 100vh; display: grid; grid-template-rows: 3.2rem minmax(0, 1fr) 1.55rem; overflow: hidden; background: #0c1220; color: #dbe5f6; font: 13px/1.45 Inter, ui-sans-serif, system-ui, sans-serif; }
.studio-body { min-width: 0; min-height: 0; display: grid; grid-template-columns: 3.75rem minmax(0, 1fr); }
.page-host { min-width: 0; min-height: 0; height: 100%; overflow: hidden; }
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
button, input, select { font: inherit; }
@media (max-width: 720px) { .studio-shell { grid-template-rows: auto minmax(0, 1fr) 1.55rem; } .studio-body { grid-template-columns: 3.35rem minmax(0, 1fr); } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }
</style>

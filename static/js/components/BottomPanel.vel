<template>
  <section class="bottom-panel" :class="{ hidden: !visible }" aria-label="Developer output">
    <header class="bottom-heading"><div class="bottom-tabs"><button :class="{ active: tab === 'problems' }" @click="select('problems')">Problems <span :class="{ good: problemCount === 0 }">{{ problemCount }}</span></button><button :class="{ active: tab === 'console' }" @click="select('console')">Console <span>{{ lines.length }}</span></button><button :class="{ active: tab === 'output' }" @click="select('output')">Output</button></div><button class="close-output" title="Close panel" aria-label="Close panel" @click="close">×</button></header>
    <div class="bottom-content" v-if="tab === 'problems'"><div v-if="problemCount === 0" class="empty-output"><span class="check-icon">✓</span><strong>No problems detected</strong><small>Build and preview errors will appear here.</small></div><div v-if="problemCount > 0" class="problem-line"><span class="error-icon">!</span><span>{{ problemCount }} problem(s) found while preparing the preview.</span></div></div>
    <div class="bottom-content console-output" v-if="tab === 'console'"><p v-if="lines.length === 0" class="empty-line">The preview console is clear.</p><p v-for="line in lines" :key="line" class="console-line">{{ line }}</p></div>
    <div class="bottom-content" v-if="tab === 'output'"><p class="empty-line">HTML Studio output is ready when you run the project.</p></div>
  </section>
</template>

<script>
export default {
  props: { visible: { type: Boolean, default: false }, tab: { type: String, default: 'problems' }, lines: { type: Array, default: [] }, problemCount: { type: Number, default: 0 } },
  methods: { select(value) { window.VelStudioShell?.setBottomTab?.(value) }, close() { window.VelStudioShell && (window.VelStudioShell.bottomVisible = false) } },
}
</script>

<style scoped>
.bottom-panel { display: grid; grid-template-rows: 2rem minmax(5.5rem, 8rem); min-height: 7.5rem; max-height: 13rem; border-top: 1px solid #223650; background: #101a2b; }.bottom-panel.hidden { display: none; }.bottom-heading { display: flex; align-items: stretch; justify-content: space-between; border-bottom: 1px solid #1c2d45; }.bottom-tabs { display: flex; align-items: stretch; gap: .2rem; }.bottom-tabs button { border: 0; border-bottom: 2px solid transparent; padding: 0 .8rem; background: transparent; color: #7f93ae; font-size: .66rem; cursor: pointer; }.bottom-tabs button:hover, .bottom-tabs button.active { color: #e7f0ff; }.bottom-tabs button.active { border-bottom-color: #62d9c7; }.bottom-tabs span { display: inline-grid; min-width: 1.1rem; margin-left: .2rem; padding: .08rem .25rem; border-radius: 99px; background: #29384e; color: #bdcbe0; font-size: .58rem; }.bottom-tabs span.good { background: #19453f; color: #71dfc8; }.close-output { align-self: center; margin-right: .5rem; border: 0; background: transparent; color: #8396b0; font-size: 1.1rem; cursor: pointer; }.close-output:hover { color: #fff; }.bottom-content { min-height: 0; overflow: auto; padding: .9rem 1rem; color: #aabbd0; font-size: .72rem; }.empty-output { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: .55rem; max-width: 24rem; }.empty-output small { grid-column: 2; color: #70849e; }.check-icon, .error-icon { display: grid; place-items: center; width: 1.25rem; height: 1.25rem; border-radius: 50%; font-weight: 900; }.check-icon { background: #19453f; color: #71dfc8; }.error-icon { background: #5a3238; color: #ff9a9a; }.problem-line { display: flex; align-items: center; gap: .6rem; color: #ffb0aa; }.empty-line { margin: 0; color: #70849e; }.console-line { margin: .15rem 0; color: #a4e7db; font-family: "Cascadia Code", Consolas, monospace; white-space: pre-wrap; }
</style>

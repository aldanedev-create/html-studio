<template>
  <header class="topbar">
    <div class="brand"><span class="brand-mark">&lt;/&gt;</span><div class="brand-copy"><strong>HTML Studio</strong><small>Learn by making</small></div><span class="crumb">{{ workspace }}</span><span class="crumb active-file">{{ activeFile }}</span><span v-if="dirty" class="dirty-dot" title="Unsaved changes" aria-label="Unsaved changes"></span></div>
    <div class="top-actions"><span class="native-badge">Local workspace</span><button class="tool-button" title="Create a new project" @click="newProject"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h6l2 2h8v11H4zM12 12v5M9.5 14.5h5" /></svg><span>New project</span></button><button class="tool-button" title="Open a folder from your computer" @click="openFolder"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5h7l2 2h9v9H3zM3 7.5V5h7l2 2" /></svg><span>Open folder</span></button><button class="tool-button" title="Save current file" @click="save"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h12l2 2v14H5zM8 4v6h8V4M8 20v-6h8v6" /></svg><span>Save</span><kbd>Ctrl S</kbd></button><button class="run-button" :class="{ running: running }" :disabled="running" :aria-label="running ? 'Running project' : 'Run project'" title="Run project" @click="run"><svg v-if="!running" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg><svg v-if="running" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10H7z" /></svg><span>{{ running ? 'Running' : 'Run' }}</span><kbd>F5</kbd></button></div>
  </header>
</template>

<script>
export default {
  props: { workspace: { type: String, default: 'workspace' }, activeFile: { type: String, default: 'index.html' }, running: { type: Boolean, default: false } },
  methods: {
    async openFolder() { try { const selected = await window.VelStudioWorkspace.openFolder(); if (selected) { await window.VelStudioApp?.refreshWorkspace?.(); window.VelStudioShell?.setStatus?.('Folder opened') } } catch (error) { window.VelStudioShell?.setStatus?.(error.message) } },
    save() { window.VelStudioEditor?.save?.() },
    run() { window.VelStudioShell?.run?.() },
    newProject() { window.VelStudioApp?.newProject?.() },
  },
}
</script>

<style scoped>
.topbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-width: 0; padding: 0 .85rem; border-bottom: 1px solid #253754; background: #141e31; box-shadow: 0 4px 18px #050a1455; }.brand, .top-actions { display: flex; align-items: center; gap: .65rem; min-width: 0; }.brand-copy { min-width: max-content; }.brand strong { display: block; color: #f2f6ff; font-size: .87rem; }.brand small { display: block; color: #8194b2; font-size: .6rem; }.brand-mark { display: grid; place-items: center; width: 2.05rem; height: 2.05rem; border: 1px solid #55cfc5; border-radius: .5rem; background: #1b3548; color: #a2f4e6; font-size: .64rem; font-weight: 900; }.crumb { overflow: hidden; max-width: 12rem; padding-left: .8rem; border-left: 1px solid #2b3b55; color: #8ea0bd; text-overflow: ellipsis; white-space: nowrap; }.active-file { color: #e8effd; font-weight: 700; }.dirty-dot { width: .42rem; height: .42rem; border-radius: 50%; background: #e4b96c; }.top-actions button { display: inline-flex; align-items: center; gap: .4rem; border-radius: .35rem; padding: .42rem .62rem; cursor: pointer; }.tool-button { border: 1px solid #304665; background: #1b2a42; color: #c5d3e8; }.tool-button:hover { border-color: #55cfc5; background: #20364d; color: #f3ffff; }.tool-button svg, .run-button svg { width: .9rem; height: .9rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }.run-button { border: 1px solid #57cfc2; background: #62d9c7; color: #10252c; font-weight: 800; }.run-button:hover { background: #82e8d9; }.top-actions kbd { color: inherit; opacity: .65; font-size: .58rem; }.native-badge { color: #7190a9; font-size: .64rem; white-space: nowrap; }
 .run-button.running, .run-button:disabled { cursor: wait; opacity: .72; }
@media (max-width: 980px) { .native-badge, .crumb { display: none; } }
@media (max-width: 620px) { .topbar { align-items: flex-start; flex-direction: column; gap: .5rem; padding-block: .55rem; }.top-actions { width: 100%; margin-left: 0; }.top-actions button { flex: 1; justify-content: center; }.top-actions kbd { display: none; }.brand { width: 100%; } }
</style>
